{
  "name": "barber-schedule",
  "version": "0.1.0",
  "description": "Sistema de gestión de citas para barbería - BarberSchedule",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -n \"NG,API\" -c \"cyan,magenta\" \"ng serve --no-hmr\" \"npm run server\"",
    "serve:web": "ng serve --no-hmr",
    "server": "json-server --watch db.json --port 3001 --host 127.0.0.1",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/animations": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.17",
    "@supabase/supabase-js": "^2.112.2",
    "gsap": "^3.13.0",
    "lottie-web": "^5.13.0",
    "rxjs": "~7.8.0",
    "three": "^0.184.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.8",
    "@angular/cli": "^21.2.8",
    "@angular/compiler-cli": "^21.2.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/three": "^0.184.1",
    "concurrently": "^9.0.0",
    "jsdom": "^28.0.0",
    "json-server": "^1.0.0-beta.3",
    "postcss": "^8.4.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
