# =====================================================
# BarberSchedule — Environment Variables (V24.1)
# =====================================================
# Copia este archivo como `.env` y llena los valores.
# NO commitees el `.env` al repo (ya está en .gitignore).
# =====================================================

# Supabase Project URL
# Lo encuentras en: Supabase → Settings → API → Project URL
SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Supabase anon public key
# Lo encuentras en: Supabase → Settings → API → Project API keys → "anon public"
# Esta key es segura de exponer en el frontend (limitada por RLS).
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...TU_KEY_AQUI

# service_role key (SOLO PARA N8N, NUNCA EN ANGULAR)
# Se usará en V24.x cuando actualicemos los workflows de n8n.
# service_role bypass-ea RLS, así que debe quedarse en el backend.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...NO_PONGAS_ESTA_EN_ANGULAR
